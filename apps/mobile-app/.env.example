# Copiar a .env.local (gitignored). Sin estas variables el app corre con mocks.

# mock (default) | http — de dónde salen los datos (ver src/lib/api.ts)
EXPO_PUBLIC_DATA_SOURCE=mock

# mock (default) | cognito — quién autentica (ver src/lib/auth/index.ts)
EXPO_PUBLIC_AUTH=mock

# Con EXPO_PUBLIC_AUTH=cognito — valores de `terraform output` en infra/envs/dev.
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Solo para Google/Facebook (Hosted UI). Vacío = sin botones de login social.
# Además requiere un build de desarrollo: Expo Go no sirve para OAuth.
EXPO_PUBLIC_COGNITO_DOMAIN=

# Backend NestJS (apps/backend). En el TELÉFONO, "localhost" es el propio
# teléfono: usar la IP de la Mac en la red local, ej. http://192.168.1.20:3001.
# En la versión web (pnpm web) localhost sí funciona.
EXPO_PUBLIC_API_URL=http://localhost:3001
