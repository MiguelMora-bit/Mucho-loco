# Cognito — login real de src/routes/LoginPage.tsx (ver infra/envs/dev en la raíz del monorepo)
# SPA sin servidor: estas variables SÍ se exponen al bundle del cliente a propósito
# (Vite requiere el prefijo VITE_ para eso) — App Client público, sin secreto.
# Valores: `terraform output` desde infra/envs/dev tras `terraform apply`.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=
# Necesario para verificar la firma del JWT contra el JWKS del User Pool
# (lib/jwt.ts) — el User Pool ID no es secreto, el JWKS es público.
VITE_COGNITO_USER_POOL_ID=

# Backend NestJS (apps/backend) — swap de datasource mock → HTTP.
# Sin VITE_DATA_SOURCE=http, los repositorios siguen usando los mocks de
# src/lib/datasources/mock/ y nada de esto hace falta.
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:3001
