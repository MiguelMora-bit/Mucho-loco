// Contrato derivado de apps/customer-app/lib/repositories/*.ts (branch, product,
// membership, user) — ver root CLAUDE.md, "Metodología: contract-first". Cada
// campo mapea 1:1 a algo que un repository mock ya modelaba, salvo donde se
// nota una mejora deliberada (ver comentarios) al pasar de mock plano a un
// backend real.
//
// Fuera de alcance de este primer corte (quedan en customer-app como mock por
// ahora): Announcement, CommunityPost/Comment, SocialLink/FeedPost (feed de
// marketing), Performance (workouts/records/heatmap). El root CLAUDE.md solo
// nombra "branches, products, orders, memberships" para este paso — el resto
// se migra en una pasada posterior.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BranchTier {
  Lite
  Core
  Premium
}

enum TierKey {
  single
  all
}

enum PlanKey {
  visit
  weekly
  monthly
  quarterly
  annual
}

enum AccessStatus {
  active
  grace
  expired
}

/// Mostrador: efectivo, tarjeta o transferencia. NO es OnlinePaymentMethod
/// (que incluye Stripe/PayPal/MercadoPago) — en una sucursal física no hay
/// pasarela en línea, y en la tienda en línea no hay caja registradora.
enum PaymentMethod {
  cash
  card
  transfer
}

enum ShiftStatus {
  open
  closed
}

enum ExpenseCategory {
  rent
  utilities
  maintenance
  supplies
  marketing
  other
}

enum EmployeeRole {
  manager
  counter
  coach
}

enum PayrollPeriodStatus {
  open
  closed
}

enum ProductCat {
  proteinas
  pre
  energy
  gomitas
  agua
  merch
}

enum OnlinePaymentMethod {
  card
  transfer
  mercadopago
  stripe
  paypal
  cash
}

enum DeliveryMethod {
  pickup
  home
}

enum OrderStatus {
  pending_payment
  ready
  done
}

enum SocialNetwork {
  instagram
  tiktok
  youtube
  facebook
}

/// '' del mock (sin actividad esa semana) se mapea a `none` — Prisma no
/// permite un variant de enum vacío.
enum HeatmapLevel {
  none
  l1
  l2
  l3
}

model Branch {
  id       Int        @id
  name     String
  city     String
  addr     String
  phone    String
  lat      Float
  lng      Float
  classes  Int
  coaches  Int
  price    Int
  tier     BranchTier
  featured Boolean    @default(false)
  /// BranchPromo { label: LocalizedString, detail: LocalizedString, discountPercent: number } — null cuando no hay promo activa.
  promo    Json?
  hours    String
  img      String

  memberships Membership[]
  visits      Visit[]
  orders      Order[]

  inventory          BranchInventory[]
  counterSales       CounterSale[]
  shifts             CashRegisterShift[]
  membershipPayments MembershipPayment[]
  attendance         AttendanceEntry[]
  transfersOut       InventoryTransfer[] @relation("transfersFrom")
  transfersIn        InventoryTransfer[] @relation("transfersTo")
  expenses           Expense[]
  employees          Employee[]

  @@map("branches")
}

model Product {
  id    String     @id
  cat   ProductCat
  /// LocalizedString { es, en }
  name  Json
  /// LocalizedString { es, en }
  flav  Json
  price Int
  img   String
  tag   String?

  inventory BranchInventory[]
  transfers InventoryTransfer[]

  @@map("products")
}

/// Catálogo de tiers de membresía (single/all) — no es específico de un
/// socio, es la tabla de precios que ve el landing. Ver Membership para la
/// membresía real de un usuario.
model MembershipTier {
  key     TierKey @id
  /// LocalizedString { es, en }
  name    Json
  factor  Float
  /// Record<Lang, string[]>
  perks   Json
  /// LocalizedString { es, en }
  badge   Json
  popular Boolean @default(false)

  @@map("membership_tiers")
}

/// La identidad vive en Cognito (auth); esta tabla es el perfil/negocio.
/// cognitoSub es el `sub` del JWT — email puede cambiar en Cognito, sub no.
/// cognitoSub es NULLABLE a propósito desde 2026-09-12: branch-app da de alta
/// socios en mostrador (con huella o solo con su nombre) que NO tienen cuenta
/// en la app, y por lo tanto no tienen usuario en Cognito. Un socio existe
/// como persona con membresía; tener login es opcional. Postgres permite
/// varios NULL en una columna UNIQUE, así que el índice sigue sirviendo para
/// los que sí tienen cuenta.
model User {
  id         String  @id @default(uuid())
  cognitoSub String? @unique
  /// También nullable, y por la misma razón que cognitoSub: un socio dado de
  /// alta en mostrador da su nombre y su teléfono, no necesariamente un
  /// correo. Un socio con app SIEMPRE tiene los dos.
  email      String? @unique
  name       String
  phone      String  @default("")
  /// String de display tal cual el mock ("14 MAR 1994") — el propio
  /// customer-app ya marcó este campo fuera de alcance de su migración a
  /// fechas ISO (ver su CLAUDE.md), así que el backend no le adelanta.
  birthdate  String  @default("")
  createdAt  DateTime @default(now())

  membership Membership?
  visits     Visit[]
  orders     Order[]

  communityPosts    CommunityPost[]
  communityLikes    CommunityLike[]
  communityComments CommunityComment[]

  @@map("users")
}

/// plan y daysLeft de MembershipInfo NO se guardan aquí — son derivados
/// (plan se arma de tierKey+periodKey+branch, daysLeft de expiresAt) y se
/// calculan en el service para no arriesgar que queden desincronizados,
/// cosa que sí le podía pasar al mock (daysLeft era un campo suelto).
model Membership {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  branchId    Int
  branch      Branch       @relation(fields: [branchId], references: [id])
  tierKey     TierKey
  periodKey   PlanKey
  expiresAt   DateTime
  status      AccessStatus @default(active)
  graceEndsAt DateTime?
  visits      Int          @default(0)
  streak      Int          @default(0)
  accessCode  String       @unique
  /// Alta por huella en mostrador (ver "Métodos de acceso" en CLAUDE.md raíz).
  /// El registro SIEMPRE conserva accessCode — la huella es un credencial
  /// adicional para validar acceso, no un reemplazo de la identidad.
  fingerprintId String?    @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payments MembershipPayment[]

  @@map("memberships")
}

/// day/month/duration del mock eran texto pre-formateado ("18"/"JUN"/"1h
/// 24m") — mismo defecto que Order.date tenía antes de la migración a ISO
/// de 2026-09-02 en customer-app. Aquí se corrige desde el inicio: fecha y
/// duración reales, el frontend formatea al mostrar.
model Visit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  visitedAt       DateTime
  durationMinutes Int

  @@map("visits")
}

model Order {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  status        OrderStatus         @default(ready)
  total         Int
  paymentMethod OnlinePaymentMethod
  delivery      DeliveryMethod
  /// Solo cuando delivery = pickup — los pedidos a domicilio salen de la
  /// bodega central, sin sucursal asociada (ver CLAUDE.md raíz).
  branchId      Int?
  branch        Branch?             @relation(fields: [branchId], references: [id])
  deliveredAt   DateTime?
  createdAt     DateTime            @default(now())

  items OrderItem[]

  @@map("orders")
}

/// name/flav son texto congelado al momento del pedido, no una referencia a
/// Product — un pedido es un recibo, no debe cambiar si el catálogo cambia
/// después (misma razón que ya documentó customer-app para este campo).
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  flav    String
  img     String
  qty     Int

  @@map("order_items")
}

/// Avisos del landing (fiestas, lanzamientos, retos) — contenido editorial,
/// no ligado a un usuario. Mismo tratamiento que Branch/Product/MembershipTier:
/// tabla semillada, sin dueño ("admin panel" para editarla queda fuera de
/// alcance, igual que hoy no existe para el resto del catálogo).
model Announcement {
  id    String   @id
  type  String
  /// LocalizedString
  badge Json
  date  DateTime
  /// LocalizedString — texto independiente de `date`, no derivado (ej. "1 JUL — 31 JUL" para un rango).
  dateLabel Json
  /// LocalizedString
  title    Json
  /// LocalizedString
  subtitle Json
  /// LocalizedString
  body Json
  /// LocalizedString
  cta  Json
  link String?
  /// LocalizedString
  location Json
  emoji    String
  accent   String

  @@map("announcements")
}

/// Handles de redes del gym (Instagram/TikTok/etc.) — contenido editorial fijo,
/// igual que Announcement.
model SocialLink {
  key       SocialNetwork @id
  name      String
  handle    String
  followers String
  url       String

  @@map("social_links")
}

/// Feed de marketing (redes externas), distinto de CommunityPost (feed
/// interno entre socios, ver abajo) — ver comentario de CommunityPost en
/// @mucho-loco/types.
model SocialFeedPost {
  id    String        @id @default(uuid())
  net   SocialNetwork
  img   String
  /// LocalizedString
  cap   Json
  likes String
  ago   String
  url   String
  /// Orden de aparición en el feed — el mock era un array ya ordenado, un
  /// SELECT sin ORDER BY no garantiza ese orden.
  sortOrder Int @default(0)

  @@map("social_feed_posts")
}

/// Feed interno entre socios ("Comunidad"). A diferencia del mock
/// (createPost recibía authorName/authorBranch como parámetros confiando en
/// el cliente), aquí el autor sale del usuario autenticado — mismo criterio
/// de seguridad que ya aplica UsersService (ver CLAUDE.md, "3 decisiones que
/// NO son fieles al mock"). authorName/authorBranch SÍ se guardan como
/// snapshot en el momento del post (igual que OrderItem.name/.flav): si el
/// socio cambia de sucursal después, sus posts viejos no deben reescribirse.
model CommunityPost {
  id           String   @id @default(uuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  authorName   String
  authorBranch String
  body         String
  createdAt    DateTime @default(now())

  likes    CommunityLike[]
  comments CommunityComment[]

  @@map("community_posts")
}

/// Like es una fila, no un contador — @@unique hace que togglear sea
/// idempotente (un segundo POST del mismo usuario quita el like en vez de
/// duplicarlo) y likeCount/likedByMe se derivan en el service, nunca se
/// guardan sueltos (mismo criterio que MembershipInfo.daysLeft).
model CommunityLike {
  id     String        @id @default(uuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("community_likes")
}

model CommunityComment {
  id         String        @id @default(uuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  authorName String
  body       String
  createdAt  DateTime      @default(now())

  @@map("community_comments")
}

/// Rendimiento (workouts/PRs/stats/heatmap) — hoy 100% contenido fijo
/// semillado, IGUAL para cualquier usuario que llame el endpoint (ni el mock
/// ni este backend personalizan por socio todavía: no existe ningún flujo
/// real que capture un entrenamiento). Queda detrás de auth (no @Public())
/// porque conceptualmente es contenido de la cuenta, pero no filtra por
/// userId — el día que exista captura real de entrenamientos, ESE es el
/// momento de agregarle userId a estos 4 modelos, no antes.
model PerformanceStat {
  id    String @id @default(uuid())
  /// LocalizedString
  lbl   Json
  num   String
  /// LocalizedString
  sub   Json
  color String
  sortOrder Int @default(0)

  @@map("performance_stats")
}

model PersonalRecord {
  id       String   @id @default(uuid())
  /// LocalizedString
  exercise Json
  weight   String
  date     DateTime
  delta    String
  sortOrder Int @default(0)

  @@map("personal_records")
}

model Workout {
  id       String   @id @default(uuid())
  date     DateTime
  /// LocalizedString
  name     Json
  sets     Int
  vol      String
  /// LocalizedString, null cuando el workout no tuvo PR.
  pr       Json?
  duration String

  @@map("workouts")
}

/// Grid fijo de 52 semanas x 7 días — reemplaza el generateHeatmap() random
/// del mock por datos deterministas (mismo request, misma respuesta).
model HeatmapCell {
  week  Int
  day   Int
  level HeatmapLevel @default(none)

  @@id([week, day])
  @@map("heatmap_cells")
}

// ---------------------------------------------------------------------------
// Operación de sucursal y HQ (2026-09-12) — contrato derivado de los
// repositorios mock de apps/branch-app y apps/owner-panel, igual que el resto
// de este esquema salió de los de customer-app. Ver root CLAUDE.md,
// "Metodología: contract-first".
//
// Lo que estos modelos desbloquean y los mocks aislados por app NO podían:
// una venta de mostrador y un pedido de la tienda descuentan del MISMO stock,
// y la asistencia que captura branch-app es la que la nómina de owner-panel
// cuenta (era el hueco explícito de la Fase 3).
// ---------------------------------------------------------------------------

/// Stock FÍSICO por sucursal. Los envíos a domicilio NO salen de aquí (salen
/// de la bodega central, ver CLAUDE.md raíz) — esta tabla solo la mueven la
/// venta de mostrador y las transferencias entre sucursales.
/// productName/unitPrice del contrato BranchInventoryLevel no se guardan: son
/// del Product y se resuelven al leer, para que un cambio de precio en el
/// catálogo no deje precios viejos regados por 15 sucursales.
model BranchInventory {
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     @default(0)

  @@id([branchId, productId])
  @@map("branch_inventory")
}

/// Venta de mostrador — descuenta stock LOCAL de la sucursal. Efectivo aquí
/// sí es normal (a diferencia de la tienda en línea, donde solo aplica con
/// "recoger en gym").
model CounterSale {
  id            String        @id @default(uuid())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  total         Int
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())

  items CounterSaleItem[]

  @@index([branchId, createdAt])
  @@map("counter_sales")
}

/// productName/unitPrice congelados al momento de la venta, igual que
/// OrderItem.name — un ticket es un recibo, no se recalcula si el catálogo
/// cambia después. productId SÍ se guarda (a diferencia de OrderItem) porque
/// el reporte de "productos más vendidos" agrupa por producto.
model CounterSaleItem {
  id          String      @id @default(uuid())
  saleId      String
  sale        CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  qty         Int
  unitPrice   Int

  @@map("counter_sale_items")
}

/// Corte de caja por turno. Invariante "a lo más uno abierto por sucursal" se
/// impone con un índice único PARCIAL (WHERE status = 'open'), creado a mano
/// en la migración — Prisma no sabe declararlos, y sin él dos cajeros que
/// abran turno a la vez crearían dos turnos abiertos.
model CashRegisterShift {
  id       String      @id @default(uuid())
  branchId Int
  branch   Branch      @relation(fields: [branchId], references: [id])
  openedAt DateTime    @default(now())
  closedAt DateTime?
  status   ShiftStatus @default(open)

  @@index([branchId, openedAt])
  @@map("cash_register_shifts")
}

/// Membresía vendida o renovada en mostrador. Entra al corte de caja junto
/// con las ventas (ShiftTransaction fusiona ambas al leer).
model MembershipPayment {
  id            String        @id @default(uuid())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  membershipId  String
  membership    Membership    @relation(fields: [membershipId], references: [id])
  /// Congelados al momento del cobro: el accessCode y el nombre pueden
  /// cambiar después, y un recibo de caja no debe cambiar con ellos.
  qrCode        String
  memberName    String
  phone         String
  tierKey       TierKey
  periodKey     PlanKey
  amount        Int
  paymentMethod PaymentMethod
  isNewMember   Boolean
  createdAt     DateTime      @default(now())

  @@index([branchId, createdAt])
  @@map("membership_payments")
}

/// Empleado de sucursal. `email` NO está en el tipo original de owner-panel —
/// se agrega porque es la llave que conecta la asistencia que captura
/// branch-app (AttendanceEntry.staffEmail) con la nómina que calcula
/// owner-panel. Sin ella los dos módulos siguen siendo islas, que es
/// exactamente el pendiente de Fase 3 que este modelo cierra.
model Employee {
  id        String       @id @default(uuid())
  branchId  Int
  branch    Branch       @relation(fields: [branchId], references: [id])
  name      String
  email     String       @unique
  role      EmployeeRole
  dailyRate Int
  hireDate  DateTime
  active    Boolean      @default(true)

  attendance AttendanceEntry[]
  payslips   Payslip[]

  @@map("employees")
}

/// Un turno trabajado. Invariante "a lo más uno abierto por empleado" también
/// va con índice único parcial (WHERE clockOut IS NULL), mismo motivo que
/// CashRegisterShift.
/// employeeId es nullable porque mostrador puede fichar a alguien que todavía
/// no está dado de alta como Employee — la asistencia se registra igual y la
/// nómina simplemente no la cuenta hasta que exista el empleado.
model AttendanceEntry {
  id         String    @id @default(uuid())
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  staffEmail String
  staffName  String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?

  @@index([branchId, clockIn])
  @@index([staffEmail, clockIn])
  @@map("attendance_entries")
}

/// Movimiento de stock entre sucursales, ya aplicado — crear una transferencia
/// y mover el inventario ocurren en la misma transacción de base de datos.
model InventoryTransfer {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  fromBranchId Int
  fromBranch   Branch   @relation("transfersFrom", fields: [fromBranchId], references: [id])
  toBranchId   Int
  toBranch     Branch   @relation("transfersTo", fields: [toBranchId], references: [id])
  qty          Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("inventory_transfers")
}

/// branchId nullable = gasto corporativo (marketing nacional, nómina de HQ)
/// que no pertenece a una sucursal — mismo criterio que ya documentó el tipo
/// Expense de @mucho-loco/types.
model Expense {
  id          String          @id @default(uuid())
  branchId    Int?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  category    ExpenseCategory
  description String
  amount      Int
  date        DateTime

  @@index([date])
  @@map("expenses")
}

/// Quincena. 'closed' es final: correr la nómina de un periodo lo cierra y sus
/// recibos ya no se recalculan.
model PayrollPeriod {
  id        String              @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  totalDays Int
  status    PayrollPeriodStatus @default(open)

  payslips Payslip[]

  @@map("payroll_periods")
}

/// employeeName/branchId/role/dailyRate están denormalizados a propósito: un
/// recibo es un documento histórico, tiene que seguir diciendo lo mismo aunque
/// el empleado cambie de sucursal, de puesto o de sueldo después.
model Payslip {
  id            String        @id @default(uuid())
  periodId      String
  period        PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  employeeName  String
  branchId      Int
  role          EmployeeRole
  daysWorked    Int
  totalDays     Int
  dailyRate     Int
  grossPay      Int
  isrDeduction  Int
  imssDeduction Int
  netPay        Int
  generatedAt   DateTime      @default(now())

  @@unique([periodId, employeeId])
  @@map("payslips")
}
