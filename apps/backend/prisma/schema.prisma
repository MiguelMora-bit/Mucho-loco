// Contrato derivado de apps/customer-app/lib/repositories/*.ts (branch, product,
// membership, user) — ver root CLAUDE.md, "Metodología: contract-first". Cada
// campo mapea 1:1 a algo que un repository mock ya modelaba, salvo donde se
// nota una mejora deliberada (ver comentarios) al pasar de mock plano a un
// backend real.
//
// Fuera de alcance de este primer corte (quedan en customer-app como mock por
// ahora): Announcement, CommunityPost/Comment, SocialLink/FeedPost (feed de
// marketing), Performance (workouts/records/heatmap). El root CLAUDE.md solo
// nombra "branches, products, orders, memberships" para este paso — el resto
// se migra en una pasada posterior.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum BranchTier {
  Lite
  Core
  Premium
}

enum TierKey {
  single
  all
}

enum PlanKey {
  visit
  weekly
  monthly
  quarterly
  annual
}

enum AccessStatus {
  active
  grace
  expired
}

/// Mostrador: efectivo, tarjeta o transferencia. NO es OnlinePaymentMethod
/// (que incluye Stripe/PayPal/MercadoPago) — en una sucursal física no hay
/// pasarela en línea, y en la tienda en línea no hay caja registradora.
enum PaymentMethod {
  cash
  card
  transfer
}

/// Tipo de tarjeta de un cobro de mostrador (spec 009): el SAT distingue la
/// forma de pago — crédito 04, débito 28. null = no se capturó (04 provisional).
enum CardType {
  credit
  debit
}

enum ShiftStatus {
  open
  closed
}

enum ExpenseCategory {
  rent
  utilities
  maintenance
  supplies
  marketing
  other
}

enum EmployeeRole {
  manager
  counter
  coach
}

enum NotificationKind {
  membership_expiring
  membership_grace
  order_ready
  payment_confirmed
  /// Bodega marcó el pedido a domicilio "en camino" (spec 008).
  order_shipped
}

enum NotificationStatus {
  sent
  failed
}

enum PaymentProvider {
  stripe
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum PayrollPeriodStatus {
  open
  closed
}

enum ProductCat {
  proteinas
  pre
  energy
  gomitas
  agua
  merch
}

enum OnlinePaymentMethod {
  card
  transfer
  mercadopago
  stripe
  paypal
  cash
}

enum DeliveryMethod {
  pickup
  home
}

enum OrderStatus {
  pending_payment
  ready
  /// Solo a domicilio: bodega ya lo dio a la paquetería.
  shipped
  done
}

enum SocialNetwork {
  instagram
  tiktok
  youtube
  facebook
}

/// '' del mock (sin actividad esa semana) se mapea a `none` — Prisma no
/// permite un variant de enum vacío.
model Branch {
  id       Int        @id
  name     String
  city     String
  addr     String
  phone    String
  lat      Float
  lng      Float
  classes  Int
  coaches  Int
  price    Int
  tier     BranchTier
  featured Boolean    @default(false)
  /// BranchPromo { label: LocalizedString, detail: LocalizedString, discountPercent: number } — null cuando no hay promo activa.
  promo    Json?
  hours    String
  img      String

  memberships Membership[]
  visits      Visit[]
  orders      Order[]

  inventory          BranchInventory[]
  counterSales       CounterSale[]
  shifts             CashRegisterShift[]
  membershipPayments MembershipPayment[]
  membershipPurchases MembershipPurchase[]
  charges            Charge[]
  attendance         AttendanceEntry[]
  transfersOut       InventoryTransfer[] @relation("transfersFrom")
  transfersIn        InventoryTransfer[] @relation("transfersTo")
  expenses           Expense[]
  employees          Employee[]

  @@map("branches")
}

model Product {
  id    String     @id
  cat   ProductCat
  /// LocalizedString { es, en }
  name  Json
  /// LocalizedString { es, en }
  flav  Json
  price Int
  img   String
  tag   String?
  /// Qué es para el SAT (ver TaxCategory). Se lee al COBRAR y se congela en
  /// ChargeLine: recategorizar un producto no cambia lo ya cobrado.
  taxCategoryId String
  taxCategory   TaxCategory @relation(fields: [taxCategoryId], references: [id])

  inventory BranchInventory[]
  transfers InventoryTransfer[]

  @@map("products")
}

/// Catálogo de tiers de membresía (single/all) — no es específico de un
/// socio, es la tabla de precios que ve el landing. Ver Membership para la
/// membresía real de un usuario.
model MembershipTier {
  key     TierKey @id
  /// LocalizedString { es, en }
  name    Json
  factor  Float
  /// Precio fijo, igual en cualquier sucursal (2026-09-15) — si está
  /// presente gana sobre factor × branch.price. Hoy solo lo trae `all`.
  basePrice Float?
  /// Record<Lang, string[]>
  perks   Json
  /// LocalizedString { es, en }
  badge   Json
  popular Boolean @default(false)
  /// Mismo papel que Product.taxCategoryId, para lo que se cobra de membresía.
  taxCategoryId String
  taxCategory   TaxCategory @relation(fields: [taxCategoryId], references: [id])

  @@map("membership_tiers")
}

/// La identidad vive en Cognito (auth); esta tabla es el perfil/negocio.
/// cognitoSub es el `sub` del JWT — email puede cambiar en Cognito, sub no.
/// cognitoSub es NULLABLE a propósito desde 2026-09-12: branch-app da de alta
/// socios en mostrador (con huella o solo con su nombre) que NO tienen cuenta
/// en la app, y por lo tanto no tienen usuario en Cognito. Un socio existe
/// como persona con membresía; tener login es opcional. Postgres permite
/// varios NULL en una columna UNIQUE, así que el índice sigue sirviendo para
/// los que sí tienen cuenta.
model User {
  id         String  @id @default(uuid())
  cognitoSub String? @unique
  /// También nullable, y por la misma razón que cognitoSub: un socio dado de
  /// alta en mostrador da su nombre y su teléfono, no necesariamente un
  /// correo. Un socio con app SIEMPRE tiene los dos.
  email      String? @unique
  name       String
  phone      String  @default("")
  /// String de display tal cual el mock ("14 MAR 1994") — el propio
  /// customer-app ya marcó este campo fuera de alcance de su migración a
  /// fechas ISO (ver su CLAUDE.md), así que el backend no le adelanta.
  birthdate  String  @default("")
  /// Cliente de Stripe. Se guarda en la primera compra de membresía para que
  /// las siguientes reusen el mismo cliente (y su tarjeta) en vez de crear uno
  /// nuevo cada vez.
  stripeCustomerId String? @unique
  createdAt  DateTime @default(now())

  membership          Membership?
  membershipPurchases MembershipPurchase[]
  visits              Visit[]
  orders              Order[]
  charges             Charge[]
  fiscalProfile       FiscalProfile?
  cfdis               Cfdi[]

  notifications     Notification[]
  communityPosts    CommunityPost[]
  communityLikes    CommunityLike[]
  communityComments CommunityComment[]

  @@map("users")
}

/// plan y daysLeft de MembershipInfo NO se guardan aquí — son derivados
/// (plan se arma de tierKey+periodKey+branch, daysLeft de expiresAt) y se
/// calculan en el service para no arriesgar que queden desincronizados,
/// cosa que sí le podía pasar al mock (daysLeft era un campo suelto).
model Membership {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  branchId    Int
  branch      Branch       @relation(fields: [branchId], references: [id])
  tierKey     TierKey
  periodKey   PlanKey
  expiresAt   DateTime
  status      AccessStatus @default(active)
  graceEndsAt DateTime?
  accessCode  String       @unique
  /// Alta por huella en mostrador (ver "Métodos de acceso" en CLAUDE.md raíz).
  /// El registro SIEMPRE conserva accessCode — la huella es un credencial
  /// adicional para validar acceso, no un reemplazo de la identidad.
  fingerprintId String?    @unique
  /// Suscripción de Stripe que la renueva sola. null = no se renueva: se pagó
  /// en mostrador, fue una visita, o la suscripción se canceló. Con
  /// suscripción, el estado lo decide Stripe (ver MembershipBillingService);
  /// sin ella, vence sola al pasar `expiresAt` (ver membership-status.ts).
  stripeSubscriptionId String? @unique
  /// El socio canceló la renovación en el portal de Stripe: la suscripción
  /// sigue viva hasta el fin del periodo pagado (`cancel_at_period_end`), pero
  /// ya no se va a cobrar. Lo copia `syncSubscription`; nunca se escribe a mano.
  renewalCanceled Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payments MembershipPayment[]

  @@map("memberships")
}

/// day/month/duration del mock eran texto pre-formateado ("18"/"JUN"/"1h
/// 24m") — mismo defecto que Order.date tenía antes de la migración a ISO
/// de 2026-09-02 en customer-app. Aquí se corrige desde el inicio: fecha y
/// duración reales, el frontend formatea al mostrar.
model Visit {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  visitedAt       DateTime
  /// Día de la entrada en hora de CDMX: una visita por socio por día (spec 012).
  visitDay        DateTime @db.Date
  /// null = no se registró la salida (sucursal solo registra la entrada).
  durationMinutes Int?

  @@unique([userId, visitDay])
  @@map("visits")
}

model Order {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  status        OrderStatus         @default(ready)
  total         Int
  paymentMethod OnlinePaymentMethod
  delivery      DeliveryMethod
  /// Solo cuando delivery = pickup — los pedidos a domicilio salen de la
  /// bodega central, sin sucursal asociada (ver CLAUDE.md raíz).
  branchId      Int?
  branch        Branch?             @relation(fields: [branchId], references: [id])
  /// ShippingAddress { street, neighborhood, city, state, postalCode, phone, references? }
  /// — solo con delivery = home. Copia congelada: si el socio se muda, el
  /// pedido no cambia de destino.
  shippingAddress Json?
  /// Solo a domicilio: cuándo lo entregó bodega a la paquetería, y con qué guía.
  shippedAt      DateTime?
  trackingNumber String?
  deliveredAt   DateTime?
  createdAt     DateTime            @default(now())

  items    OrderItem[]
  payments Payment[]
  /// El cobro, cuando ya ocurrió: al confirmar Stripe, o al entregar si es en efectivo.
  charge   Charge?

  @@map("orders")
}

/// name/flav son texto congelado al momento del pedido, no una referencia a
/// Product — un pedido es un recibo, no debe cambiar si el catálogo cambia
/// después (misma razón que ya documentó customer-app para este campo).
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  flav    String
  img     String
  qty     Int
  /// Congelados al hacer el pedido, igual que CounterSaleItem: el cobro puede
  /// llegar después (efectivo al recoger, OXXO) y su renglón tiene que llevar
  /// el precio que se le cotizó al socio, no el del catálogo de ese día.
  /// Nullable solo por los pedidos anteriores a este campo.
  productId String?
  unitPrice Int?

  @@map("order_items")
}

/// Avisos del landing (fiestas, lanzamientos, retos) — contenido editorial,
/// no ligado a un usuario. Mismo tratamiento que Branch/Product/MembershipTier:
/// tabla semillada, sin dueño ("admin panel" para editarla queda fuera de
/// alcance, igual que hoy no existe para el resto del catálogo).
model Announcement {
  id    String   @id
  type  String
  /// LocalizedString
  badge Json
  date  DateTime
  /// LocalizedString — texto independiente de `date`, no derivado (ej. "1 JUL — 31 JUL" para un rango).
  dateLabel Json
  /// LocalizedString
  title    Json
  /// LocalizedString
  subtitle Json
  /// LocalizedString
  body Json
  /// LocalizedString
  cta  Json
  link String?
  /// LocalizedString
  location Json
  emoji    String
  accent   String

  @@map("announcements")
}

/// Handles de redes del gym (Instagram/TikTok/etc.) — contenido editorial fijo,
/// igual que Announcement.
model SocialLink {
  key       SocialNetwork @id
  name      String
  handle    String
  followers String
  url       String

  @@map("social_links")
}

/// Feed de marketing (redes externas), distinto de CommunityPost (feed
/// interno entre socios, ver abajo) — ver comentario de CommunityPost en
/// @mucho-loco/types.
model SocialFeedPost {
  id    String        @id @default(uuid())
  net   SocialNetwork
  img   String
  /// LocalizedString
  cap   Json
  likes String
  ago   String
  url   String
  /// Orden de aparición en el feed — el mock era un array ya ordenado, un
  /// SELECT sin ORDER BY no garantiza ese orden.
  sortOrder Int @default(0)

  @@map("social_feed_posts")
}

/// Feed interno entre socios ("Comunidad"). A diferencia del mock
/// (createPost recibía authorName/authorBranch como parámetros confiando en
/// el cliente), aquí el autor sale del usuario autenticado — mismo criterio
/// de seguridad que ya aplica UsersService (ver CLAUDE.md, "3 decisiones que
/// NO son fieles al mock"). authorName/authorBranch SÍ se guardan como
/// snapshot en el momento del post (igual que OrderItem.name/.flav): si el
/// socio cambia de sucursal después, sus posts viejos no deben reescribirse.
model CommunityPost {
  id           String   @id @default(uuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  authorName   String
  authorBranch String
  body         String
  createdAt    DateTime @default(now())

  likes    CommunityLike[]
  comments CommunityComment[]

  @@map("community_posts")
}

/// Like es una fila, no un contador — @@unique hace que togglear sea
/// idempotente (un segundo POST del mismo usuario quita el like en vez de
/// duplicarlo) y likeCount/likedByMe se derivan en el service, nunca se
/// guardan sueltos (mismo criterio que MembershipInfo.daysLeft).
model CommunityLike {
  id     String        @id @default(uuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("community_likes")
}

model CommunityComment {
  id         String        @id @default(uuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  authorName String
  body       String
  createdAt  DateTime      @default(now())

  @@map("community_comments")
}

/// Rendimiento (workouts/PRs/stats) — hoy contenido fijo semillado, IGUAL
/// para cualquier usuario (no existe ningún flujo real que capture un
/// entrenamiento). Queda detrás de auth porque es contenido de la cuenta, pero
/// no filtra por userId — el día que exista captura real de entrenamientos,
/// ESE es el momento de agregarle userId a estos 3 modelos, no antes. El
/// heatmap ya no vive aquí: sale de las visitas reales del socio (spec 016).
model PerformanceStat {
  id    String @id @default(uuid())
  /// LocalizedString
  lbl   Json
  num   String
  /// LocalizedString
  sub   Json
  color String
  sortOrder Int @default(0)

  @@map("performance_stats")
}

model PersonalRecord {
  id       String   @id @default(uuid())
  /// LocalizedString
  exercise Json
  weight   String
  date     DateTime
  delta    String
  sortOrder Int @default(0)

  @@map("personal_records")
}

model Workout {
  id       String   @id @default(uuid())
  date     DateTime
  /// LocalizedString
  name     Json
  sets     Int
  vol      String
  /// LocalizedString, null cuando el workout no tuvo PR.
  pr       Json?
  duration String

  @@map("workouts")
}


// ---------------------------------------------------------------------------
// Operación de sucursal y HQ (2026-09-12) — contrato derivado de los
// repositorios mock de apps/branch-app y apps/owner-panel, igual que el resto
// de este esquema salió de los de customer-app. Ver root CLAUDE.md,
// "Metodología: contract-first".
//
// Lo que estos modelos desbloquean y los mocks aislados por app NO podían:
// una venta de mostrador y un pedido de la tienda descuentan del MISMO stock,
// y la asistencia que captura branch-app es la que la nómina de owner-panel
// cuenta (era el hueco explícito de la Fase 3).
// ---------------------------------------------------------------------------

/// Stock FÍSICO por sucursal. Los envíos a domicilio NO salen de aquí (salen
/// de la bodega central, ver CLAUDE.md raíz) — esta tabla solo la mueven la
/// venta de mostrador y las transferencias entre sucursales.
/// productName/unitPrice del contrato BranchInventoryLevel no se guardan: son
/// del Product y se resuelven al leer, para que un cambio de precio en el
/// catálogo no deje precios viejos regados por 15 sucursales.
model BranchInventory {
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     @default(0)

  @@id([branchId, productId])
  @@map("branch_inventory")
}

/// Venta de mostrador — descuenta stock LOCAL de la sucursal. Efectivo aquí
/// sí es normal (a diferencia de la tienda en línea, donde solo aplica con
/// "recoger en gym").
model CounterSale {
  id            String        @id @default(uuid())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  total         Int
  paymentMethod PaymentMethod
  /// Solo con `paymentMethod = card` (spec 009).
  cardType      CardType?
  createdAt     DateTime      @default(now())

  items  CounterSaleItem[]
  charge Charge?

  @@index([branchId, createdAt])
  @@map("counter_sales")
}

/// productName/unitPrice congelados al momento de la venta, igual que
/// OrderItem.name — un ticket es un recibo, no se recalcula si el catálogo
/// cambia después. productId SÍ se guarda (a diferencia de OrderItem) porque
/// el reporte de "productos más vendidos" agrupa por producto.
model CounterSaleItem {
  id          String      @id @default(uuid())
  saleId      String
  sale        CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  qty         Int
  unitPrice   Int

  @@map("counter_sale_items")
}

/// Corte de caja por turno. Invariante "a lo más uno abierto por sucursal" se
/// impone con un índice único PARCIAL (WHERE status = 'open'), creado a mano
/// en la migración — Prisma no sabe declararlos, y sin él dos cajeros que
/// abran turno a la vez crearían dos turnos abiertos.
model CashRegisterShift {
  id       String      @id @default(uuid())
  branchId Int
  branch   Branch      @relation(fields: [branchId], references: [id])
  openedAt DateTime    @default(now())
  closedAt DateTime?
  status   ShiftStatus @default(open)

  @@index([branchId, openedAt])
  @@map("cash_register_shifts")
}

/// Membresía vendida o renovada en mostrador. Entra al corte de caja junto
/// con las ventas (ShiftTransaction fusiona ambas al leer).
model MembershipPayment {
  id            String        @id @default(uuid())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  membershipId  String
  membership    Membership    @relation(fields: [membershipId], references: [id])
  /// Congelados al momento del cobro: el accessCode y el nombre pueden
  /// cambiar después, y un recibo de caja no debe cambiar con ellos.
  qrCode        String
  memberName    String
  phone         String
  tierKey       TierKey
  periodKey     PlanKey
  amount        Int
  paymentMethod PaymentMethod
  /// Solo con `paymentMethod = card` (spec 009).
  cardType      CardType?
  isNewMember   Boolean
  createdAt     DateTime      @default(now())

  charge Charge?

  @@index([branchId, createdAt])
  @@map("membership_payments")
}

/// Empleado de sucursal. `email` NO está en el tipo original de owner-panel —
/// se agrega porque es la llave que conecta la asistencia que captura
/// branch-app (AttendanceEntry.staffEmail) con la nómina que calcula
/// owner-panel. Sin ella los dos módulos siguen siendo islas, que es
/// exactamente el pendiente de Fase 3 que este modelo cierra.
model Employee {
  id        String       @id @default(uuid())
  branchId  Int
  branch    Branch       @relation(fields: [branchId], references: [id])
  name      String
  email     String       @unique
  role      EmployeeRole
  dailyRate Int
  hireDate  DateTime
  active    Boolean      @default(true)

  attendance AttendanceEntry[]
  payslips   Payslip[]

  @@map("employees")
}

/// Un turno trabajado. Invariante "a lo más uno abierto por empleado" también
/// va con índice único parcial (WHERE clockOut IS NULL), mismo motivo que
/// CashRegisterShift.
/// employeeId es nullable porque mostrador puede fichar a alguien que todavía
/// no está dado de alta como Employee — la asistencia se registra igual y la
/// nómina simplemente no la cuenta hasta que exista el empleado.
model AttendanceEntry {
  id         String    @id @default(uuid())
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  staffEmail String
  staffName  String
  clockIn    DateTime  @default(now())
  clockOut   DateTime?

  @@index([branchId, clockIn])
  @@index([staffEmail, clockIn])
  @@map("attendance_entries")
}

/// Movimiento de stock entre sucursales, ya aplicado — crear una transferencia
/// y mover el inventario ocurren en la misma transacción de base de datos.
model InventoryTransfer {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  fromBranchId Int
  fromBranch   Branch   @relation("transfersFrom", fields: [fromBranchId], references: [id])
  toBranchId   Int
  toBranch     Branch   @relation("transfersTo", fields: [toBranchId], references: [id])
  qty          Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("inventory_transfers")
}

/// branchId nullable = gasto corporativo (marketing nacional, nómina de HQ)
/// que no pertenece a una sucursal — mismo criterio que ya documentó el tipo
/// Expense de @mucho-loco/types.
model Expense {
  id          String          @id @default(uuid())
  branchId    Int?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  category    ExpenseCategory
  description String
  amount      Int
  date        DateTime

  @@index([date])
  @@map("expenses")
}

/// Quincena. 'closed' es final: correr la nómina de un periodo lo cierra y sus
/// recibos ya no se recalculan.
model PayrollPeriod {
  id        String              @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  totalDays Int
  status    PayrollPeriodStatus @default(open)

  payslips Payslip[]

  @@map("payroll_periods")
}

/// employeeName/branchId/role/dailyRate están denormalizados a propósito: un
/// recibo es un documento histórico, tiene que seguir diciendo lo mismo aunque
/// el empleado cambie de sucursal, de puesto o de sueldo después.
model Payslip {
  id            String        @id @default(uuid())
  periodId      String
  period        PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  employeeName  String
  branchId      Int
  role          EmployeeRole
  daysWorked    Int
  totalDays     Int
  dailyRate     Int
  grossPay      Int
  isrDeduction  Int
  imssDeduction Int
  netPay        Int
  generatedAt   DateTime      @default(now())

  @@unique([periodId, employeeId])
  @@map("payslips")
}


/// Intento de cobro en línea de un pedido.
///
/// Tabla aparte y no columnas en Order porque son ciclos de vida distintos:
/// un pedido puede acumular varios intentos (el socio abandona el checkout y
/// vuelve a intentar) y cada uno tiene su propio estado en la pasarela. Además
/// deja lugar para PayPal y Mercado Pago sin volver a tocar Order.
model Payment {
  id       String          @id @default(uuid())
  orderId  String
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  status   PaymentStatus   @default(pending)
  amount   Int
  currency String          @default("mxn")

  /// Id de la sesión de Checkout. Único: el webhook llega por sesión y este
  /// índice es lo que hace que reprocesar el mismo evento no cobre dos veces.
  providerSessionId String  @unique
  /// Se llena cuando la sesión se completa — es el id con el que se hace un
  /// reembolso o se busca el cobro en el dashboard de Stripe.
  providerPaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

/// Compra de membresía en línea — lo que el socio eligió y pagó en Stripe.
/// Hermana de `Payment` (que es de pedidos de la tienda) y de
/// `MembershipPayment` (cobros de mostrador). Existe por dos razones: congelar
/// sucursal/tier/periodo/importe del momento de la compra, y hacer idempotente
/// el webhook — Stripe reentrega eventos, y una visita cobrada una vez no
/// puede extender la membresía dos.
model MembershipPurchase {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  tierKey   TierKey
  periodKey PlanKey
  amount    Int
  currency  String   @default("mxn")
  provider  PaymentProvider
  status    PaymentStatus @default(pending)

  /// Id de la sesión de Checkout — el webhook llega por sesión.
  providerSessionId      String  @unique
  /// Solo en planes recurrentes; se llena cuando la sesión se completa.
  providerSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Solo visitas: el dinero de una suscripción se registra por cada
  /// invoice.paid (ver Charge.stripeInvoiceId), el primero incluido.
  charge Charge?

  @@index([userId])
  @@map("membership_purchases")
}


/// Aviso enviado por WhatsApp.
///
/// Existe sobre todo por IDEMPOTENCIA: `@@unique([userId, kind, dedupeKey])`
/// es lo que impide mandarle al socio el mismo "tu membresía vence en 3 días"
/// cada vez que corre el cron. Sin esta tabla, el aviso diario sería un aviso
/// por minuto en cuanto alguien cambie el intervalo.
///
/// También es el registro de qué se le dijo a quién: si un socio reclama que
/// nunca le avisaron, aquí está la respuesta.
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind
  status NotificationStatus @default(sent)

  /// Qué hecho concreto se está avisando: la fecha de vencimiento, el id del
  /// pedido. Dos avisos del mismo tipo con distinta llave sí se mandan los dos
  /// — vencer en julio y vencer en agosto son avisos distintos.
  dedupeKey String

  /// Teléfono al que se mandó, congelado: el socio puede cambiarlo después y
  /// el registro tiene que seguir diciendo a dónde fue.
  phone String
  /// Plantilla aprobada de Meta que se usó.
  template String
  /// Id que devolvió Meta, para rastrear la entrega. Null si el envío falló.
  providerMessageId String?
  error             String?

  createdAt DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}


// ─── Registro de cobros ──────────────────────────────────────────────────────
// Paso 1 de facturación (2026-09-14): antes de emitir un solo CFDI hace falta
// saber, en UN lugar, cada peso que entró. Ver "Registro de cobros" en
// apps/backend/CLAUDE.md.

/// De dónde salió el dinero. Un cobro tiene exactamente un origen.
enum ChargeSource {
  /// Pedido de tienda: cobrado por Stripe, o en efectivo al recogerlo.
  order
  counter_sale
  counter_membership
  /// Visita comprada en línea (pago único).
  membership_visit
  /// CADA cobro de una suscripción, el primero incluido.
  membership_subscription
}

/// Cómo se pagó, tal como ocurrió. Traducirlo a la forma de pago del SAT
/// (c_FormaPago) es trabajo de facturación, no de este registro.
enum ChargeMethod {
  cash
  /// Tarjeta sin saber si es de crédito o débito: la terminal de mostrador
  /// no lo captura todavía, y Stripe a veces no lo sabe (prepago).
  card
  card_credit
  card_debit
  oxxo
  spei
  /// Transferencia recibida en mostrador.
  transfer
}

/// Qué es cada cosa que se vende, para el SAT. Lo mantiene el contador, no el
/// código: muchos productos comparten categoría, y cambiar la clave de todas
/// las proteínas es cambiar UNA fila.
model TaxCategory {
  id            String @id
  name          String
  /// ClaveProdServ del catálogo del SAT.
  satProductKey String
  /// ClaveUnidad del catálogo del SAT (H87 = pieza, E48 = unidad de servicio).
  satUnitKey    String
  /// Tasa de IVA en puntos base: 1600 = 16 %. Int y no Float: dinero y tasas
  /// no se guardan en flotante.
  taxRateBp     Int

  products Product[]
  tiers    MembershipTier[]

  @@map("tax_categories")
}

/// Registro único de ingresos: un cobro confirmado = una fila, venga del canal
/// que venga. Las tablas de cada canal (Payment, CounterSale,
/// MembershipPayment, MembershipPurchase) siguen siendo el detalle operativo;
/// ésta es la que leen los reportes y la que va a leer facturación.
///
/// Nunca se edita. Un reembolso será otra fila, cuando exista la política.
///
/// Montos en CENTAVOS, a diferencia del resto del schema: el desglose de IVA
/// (total / 1.16) da decimales, y con pesos enteros el redondeo no cuadra
/// contra el XML de la factura.
model Charge {
  id         String       @id @default(uuid())
  source     ChargeSource
  method     ChargeMethod
  totalCents Int
  currency   String       @default("mxn")
  /// Cuándo entró el dinero — no cuándo se hizo el pedido. Decide en qué mes
  /// se factura.
  paidAt     DateTime

  /// null = pedido a domicilio: sale de la bodega central, sin sucursal.
  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// null = cliente de mostrador sin cuenta. Borrar al socio no borra lo que
  /// pagó: el ingreso existió igual.
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  /// Exactamente UNO de estos cinco: CHECK escrito a mano en la migración,
  /// porque Prisma no sabe declararlo. Todos únicos: es lo que hace
  /// idempotente registrar el cobro cuando Stripe reentrega un webhook.
  /// `Restrict` y no el `SetNull` por defecto: no se borra lo que originó un
  /// ingreso, y SetNull además rompería el CHECK.
  orderId              String?             @unique
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  counterSaleId        String?             @unique
  counterSale          CounterSale?        @relation(fields: [counterSaleId], references: [id], onDelete: Restrict)
  membershipPaymentId  String?             @unique
  membershipPayment    MembershipPayment?  @relation(fields: [membershipPaymentId], references: [id], onDelete: Restrict)
  membershipPurchaseId String?             @unique
  membershipPurchase   MembershipPurchase? @relation(fields: [membershipPurchaseId], references: [id], onDelete: Restrict)
  /// `in_…` de Stripe. Una suscripción no deja fila propia por cobro en
  /// ningún otro lado: sin esto, del mes 2 en adelante no había registro.
  stripeInvoiceId      String?             @unique

  lines ChargeLine[]
  /// null = cobro anterior a la facturación (paso 2): no tiene recibo.
  fiscalReceipt FiscalReceipt?

  createdAt DateTime @default(now())

  @@index([paidAt])
  @@index([branchId, paidAt])
  @@map("charges")
}

/// Renglón del cobro, con su dato fiscal CONGELADO — mismo criterio que
/// OrderItem y CounterSaleItem. El envío a domicilio también es renglón: el
/// SAT lo quiere como concepto aparte, no sumado al producto.
model ChargeLine {
  id             String @id @default(uuid())
  chargeId       String
  charge         Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  description    String
  qty            Int
  /// IVA incluido: el precio que vio el cliente.
  unitPriceCents Int
  taxCategoryId  String
  satProductKey  String
  satUnitKey     String
  taxRateBp      Int

  @@index([chargeId])
  @@map("charge_lines")
}

// ─── Facturación CFDI 4.0 (2026-09-15) — paso 2 ─────────────────────────────
// Ver "Facturación CFDI" en apps/backend/CLAUDE.md.

/// Datos fiscales del socio, tal cual su Constancia de Situación Fiscal. Se
/// COPIAN a la factura al emitirla: cambiarlos después no toca una ya timbrada.
model FiscalProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RFC, en mayúsculas.
  taxId     String
  /// Nombre o razón social, sin el régimen societario ("SA DE CV").
  legalName String
  /// c_RegimenFiscal del SAT (601, 605, 612, 626…).
  taxSystem String
  /// Código postal del domicilio fiscal: CFDI 4.0 lo valida contra el SAT.
  zip       String
  /// c_UsoCFDI.
  cfdiUse   String   @default("G03")
  /// A dónde manda Facturapi el PDF y el XML. null = el correo de la cuenta.
  email     String?
  updatedAt DateTime @updatedAt

  @@map("fiscal_profiles")
}

enum FiscalReceiptStatus {
  /// En la cola: falta darlo de alta en Facturapi.
  pending
  /// Dado de alta: se puede facturar a un cliente.
  open
  /// Facturado a un cliente, desde la app o desde el portal de autofactura.
  invoiced_to_customer
  /// Entró a la factura global del periodo: ya no se puede facturar aparte.
  invoiced_globally
  canceled
  /// Agotó los reintentos: alguien tiene que revisarlo.
  failed
}

/// El recibo electrónico de Facturapi de un cobro — y a la vez la cola
/// (outbox) que lo manda. Cada cobro nace con su fila en `pending`, en la
/// misma transacción que lo registra (ChargesService); FiscalReceiptsService
/// la da de alta en Facturapi y reintenta si falla.
///
/// Todo cobro pasa por aquí y no directo a una factura porque así funciona el
/// PAC: el recibo se puede facturar a un cliente (desde la app o con la clave
/// del ticket en el portal) y lo que nadie facturó entra solo a la factura
/// global del periodo.
model FiscalReceipt {
  chargeId       String              @id
  charge         Charge              @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  status         FiscalReceiptStatus @default(pending)
  attempts       Int                 @default(0)
  /// Cuándo lo vuelve a intentar el worker. También es el arriendo: al tomar
  /// un recibo se empuja 5 minutos para que otra instancia no lo tome.
  nextAttemptAt  DateTime            @default(now())
  lastError      String?
  facturapiId    String?             @unique
  /// Clave de autofacturación: la que va impresa en el ticket.
  key            String?             @unique
  selfInvoiceUrl String?
  /// Hasta cuándo deja autofacturar el portal. Por API se puede después.
  expiresAt      DateTime?
  cfdiId         String?
  cfdi           Cfdi?               @relation(fields: [cfdiId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([cfdiId])
  @@map("fiscal_receipts")
}

enum CfdiKind {
  individual
  global
}

enum CfdiStatus {
  valid
  canceled
}

/// Una factura timbrada ante el SAT. El dato vivo está en Facturapi; aquí va
/// lo necesario para listarla y encontrarla sin pedírselo.
model Cfdi {
  id                 String     @id @default(uuid())
  facturapiId        String     @unique
  /// Folio fiscal que asigna el SAT.
  uuid               String     @unique
  kind               CfdiKind
  status             CfdiStatus @default(valid)
  /// Solicitud de cancelación ante el SAT tal cual la reporta el PAC: none,
  /// pending, accepted, rejected, expired… (el receptor a veces tiene que aceptarla).
  cancellationStatus String     @default("none")
  totalCents         Int
  customerTaxId      String
  customerLegalName  String
  /// Quién la pidió desde la app. null = factura global, o autofactura del portal.
  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  issuedAt           DateTime
  receipts           FiscalReceipt[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([issuedAt])
  @@index([userId])
  @@map("cfdis")
}
