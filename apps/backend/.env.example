# Local dev: postgresql://<tu-usuario-de-mac>@localhost:5432/mucho_loco_dev
# Producción: viene de `terraform output` en infra/envs/dev (RDS Postgres).
DATABASE_URL=

# Cognito — para validar el JWT (ver lib/jwt.ts en customer-app, mismo patrón
# via jose/JWKS). Valores de `terraform output` en infra/envs/dev.
COGNITO_REGION=
COGNITO_USER_POOL_ID=

PORT=3001

# Stripe — pagos con tarjeta de la tienda (ver "Pagos" en CLAUDE.md).
# Sin estas, TODO el resto del backend funciona igual; solo
# /payments/* falla al usarse. Nunca commitear valores reales.
#
# Llaves de prueba sin registrarse: `npm i -g @stripe/cli && stripe sandbox create`.
# Preferir una restricted key (rk_...) sobre una secret key (sk_...).
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:3001/payments/stripe/webhook` la imprime.
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API de Meta) — avisos de vencimiento,
# pedido listo y confirmación de pago (ver "Notificaciones" en CLAUDE.md).
# Sin estas, el backend corre igual y los avisos se omiten con un warning.
#
# Meta for Developers > tu app > WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret (Configuración > Básica) — verifica la firma del webhook.
WHATSAPP_APP_SECRET=
# Lo inventas tú y lo pegas igual en Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# Opcional; default v21.0.
WHATSAPP_API_VERSION=
